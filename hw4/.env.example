# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored. Never commit real keys.

# Required for the shop assistant chat: your Portkey gateway API key.
PORTKEY_API_KEY=your_portkey_api_key_here

# Recommended: signs the login cookie so users stay logged in across restarts.
# Use any long random string, e.g. the output of: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_long_random_string

# Optional overrides (defaults shown).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# OPENAI_MODEL=gpt-5.6-luna

# Optional, mainly for testing: alternate database / audit trail locations.
# CAMPUS_CUSTOMS_DB=../data/campus_customs.db
# AUDIT_TRAIL_PATH=../output/audit_trail.json
